# Application
APP_ENV=development
APP_NAME=Persian Speech Intelligence
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Security (leave empty for local demo; set for non-localhost deployments)
API_KEY=
AUTH_ENABLED=false

# Database
# Production / Docker:
DATABASE_URL=postgresql+psycopg://psi:psi_secret@localhost:5432/persian_speech
# Local demo without Postgres (uncomment and comment the line above):
# DATABASE_URL=sqlite:///./storage/psi_local.db

# Storage (repo-root paths when processes run from backend/)
STORAGE_DIR=../storage
UPLOAD_DIR=../storage/uploads
TEMP_DIR=../storage/temp
VECTOR_INDEX_DIR=../storage/vector_indexes

# Upload limits
MAX_UPLOAD_MB=100
MAX_AUDIO_DURATION_SECONDS=3600
MIN_AUDIO_DURATION_SECONDS=0.5

# Speech-to-Text — Faster-Whisper Medium (GPU)
# No CUDA? use WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=fa
WHISPER_AUTO_DETECT_LANGUAGE=false
WHISPER_BEAM_SIZE=5

# Embedding — multilingual-e5-small (CPU); FAISS (CPU); no reranker
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=80
RETRIEVAL_TOP_K=5

# LLM — Qwen3-2B-Instruct-2507 Q4 (GPU)
# Combined analysis = one JSON call (summary/topics/entities/sentiment)
LLM_PROVIDER=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=Qwen3-2B-Instruct-2507
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=1024
LLM_ANALYSIS_MAX_TOKENS=1536
LLM_TEMPERATURE=0.2
LLM_REQUEST_PAUSE_SECONDS=1.5
ANALYSIS_TRANSCRIPT_MAX_CHARS=8000

LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=Qwen3-2B-Instruct-2507

# Optional separate sentiment model (off by default — avoids GPU model swap)
SENTIMENT_MODEL=Qwen3-4B
LOCAL_SENTIMENT_MODEL=Qwen3-4B
SENTIMENT_USE_SEPARATE_MODEL=false

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=1
WORKER_MAX_RETRIES=2
JOB_STALE_TIMEOUT_SECONDS=7200

# Retention (days; 0 = keep forever)
RETENTION_DAYS=0

# Frontend
BACKEND_URL=http://localhost:8000
