# Application
APP_ENV=development
APP_NAME=Persian Speech Intelligence
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Security (leave empty for local demo; set for non-localhost deployments)
API_KEY=
AUTH_ENABLED=false

# Database
DATABASE_URL=postgresql+psycopg://psi:psi_secret@localhost:5432/persian_speech

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
TEMP_DIR=./storage/temp
VECTOR_INDEX_DIR=./storage/vector_indexes

# Upload limits
MAX_UPLOAD_MB=100
MAX_AUDIO_DURATION_SECONDS=3600
MIN_AUDIO_DURATION_SECONDS=0.5

# Whisper ASR
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fa
WHISPER_AUTO_DETECT_LANGUAGE=false
WHISPER_BEAM_SIZE=5

# Embeddings / RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=80
RETRIEVAL_TOP_K=5

# LLM provider: openai_compatible | local
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# Local LLM adapter (used when LLM_PROVIDER=local)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=1
WORKER_MAX_RETRIES=2
JOB_STALE_TIMEOUT_SECONDS=7200

# Retention (days; 0 = keep forever)
RETENTION_DAYS=0

# Frontend
BACKEND_URL=http://localhost:8000
